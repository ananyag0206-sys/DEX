// =======================================
// 📘 Prisma Schema — Contact Management System
// Database: MongoDB (Docker + Prisma Studio Ready)
// =======================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["mongoDb"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// 👤 USER MODEL
// Each user can manage multiple contacts
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  contacts  Contact[] @relation("UserContacts")
}

// 📇 CONTACT MODEL
// Stores individual contacts belonging to a specific user
model Contact {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String?
  email     String?
  phone     String?
  address   String?
  company   String?
  notes     String?
  favorite  Boolean  @default(false)
  tags      String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId        String         @db.ObjectId
  user          User           @relation("UserContacts", fields: [userId], references: [id])
  contactGroups ContactGroup[] @relation("ContactToGroups")
}

// 📂 GROUP MODEL
// Used to organize contacts
model Group {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())

  // Relations
  contacts ContactGroup[] @relation("GroupToContacts")
}

// 🔗 INTERMEDIATE MODEL
// Many-to-Many between Contact and Group
model ContactGroup {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  contactId String @db.ObjectId
  groupId   String @db.ObjectId

  // Relations
  contact Contact @relation(
    "ContactToGroups",
    fields: [contactId],
    references: [id]
  )

  group Group @relation(
    "GroupToContacts",
    fields: [groupId],
    references: [id]
  )

  // Prevent duplicate contact-group links
  @@unique([contactId, groupId])
}